# Copiar a frontend/.env. Las variables VITE_* son públicas en la web.
# Nunca incluir contraseñas, JWT_SECRET ni claves privadas de Cloudinary o Atlas.

# API · ruta del proxy de Vite en local y del proxy del frontend en producción.
# Mantener /api/v1 con la configuración actual.
# Antes de desplegar, configurar la URL real del backend en frontend/vercel.json.
VITE_API_URL=/api/v1
