{
  "name": "kelsets-cars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend && npm test -w frontend && npm test -w packages/api-client",
    "seed:check": "npm run seed:check -w backend",
    "seed": "npm run seed -w backend",
    "data:export": "node scripts/exportDataset.mjs",
    "data:check": "node scripts/exportDataset.mjs --check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
