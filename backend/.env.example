# Copiar a backend/.env y rellenar allí. Este ejemplo no contiene secretos.
# backend/.env está excluido de Git. No introducir credenciales en el frontend.

# SERVIDOR LOCAL
# En el despliegue configurar NODE_ENV=production.
# El proveedor puede asignar PORT automáticamente.
NODE_ENV=development
PORT=3000

# MONGODB ATLAS · obligatorio para catálogo, usuarios y citas
# Copiar la URI de conexión y añadir el nombre de la base: kelsets_cars.
# Formato orientativo (sustituir todos los marcadores):
# mongodb+srv://USUARIO:CLAVE_CODIFICADA@HOST_ATLAS/kelsets_cars?retryWrites=true&w=majority
# Codificar los caracteres especiales de la contraseña para su uso en una URL.
MONGODB_URI=

# SESIÓN · obligatorio; secreto aleatorio de al menos 32 caracteres
# Generarlo localmente con: openssl rand -hex 32
# Utilizar secretos diferentes para desarrollo y producción.
JWT_SECRET=

# ORÍGENES AUTORIZADOS · sin barra final ni rutas
# Se admiten varios, separados por comas. No utilizar comodines.
# En producción sustituir por la URL HTTPS real del frontend.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# CLOUDINARY · necesario para subir imágenes; solo en el backend
# Rellenar los tres valores con los de la cuenta de Cloudinary.
# Si se dejan vacíos, el resto de la aplicación funciona sin subidas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SEMILLA · creación opcional de una cuenta administradora
# Rellenar ambos valores o dejar ambos vacíos.
# ADMIN_PASSWORD: entre 10 y 72 caracteres.
# La cuenta se crea al ejecutar npm run seed; repetirlo no cambia su contraseña.
# Estos valores no son necesarios para ejecutar la aplicación tras crear la cuenta.
ADMIN_EMAIL=
ADMIN_PASSWORD=
